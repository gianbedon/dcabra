<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>D'Cabra</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #F7F3EC;
    --dark: #1C1A14;
    --gold: #C8922A;
    --green: #3B6E45;
    --green-light: #EAF2EC;
    --white: #FFFFFF;
    --gray: #767676;
    --border: #E2DBD0;
  }

  body { font-family: 'Inter', sans-serif; background: var(--white); color: var(--dark); }

  /* ── NAV ── */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--border);
    padding: 0 5%;
    display: flex; align-items: center; justify-content: space-between;
    height: 64px;
  }
  .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav-logo svg { width: 36px; height: 36px; }
  .nav-logo span { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; color: var(--dark); }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a { text-decoration: none; font-size: .88rem; font-weight: 500; color: var(--dark); transition: color .2s; }
  .nav-links a:hover { color: var(--gold); }
  .nav-cta {
    background: var(--green); color: var(--white);
    border: none; border-radius: 50px;
    padding: 10px 22px; font-size: .85rem; font-weight: 600;
    cursor: pointer; text-decoration: none; transition: background .2s;
  }
  .nav-cta:hover { background: #2e5535; }

  /* ── HERO BANNER ── */
  .hero {
    background: linear-gradient(135deg, #1C1A14 0%, #2e2a1a 50%, #3B6E45 100%);
    min-height: 420px;
    display: flex; align-items: center;
    padding: 60px 5%;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(200,146,42,.18) 0%, transparent 60%);
  }
  .hero-badge {
    background: var(--gold);
    color: var(--white);
    font-size: .72rem; font-weight: 700; letter-spacing: .08em;
    padding: 5px 14px; border-radius: 50px;
    display: inline-block; margin-bottom: 16px; text-transform: uppercase;
  }
  .hero-content { position: relative; z-index: 1; max-width: 520px; }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    color: var(--white); line-height: 1.1; margin-bottom: 16px;
  }
  .hero h1 em { color: var(--gold); font-style: normal; }
  .hero p { color: rgba(255,255,255,.75); font-size: 1rem; line-height: 1.6; margin-bottom: 28px; }
  .hero-tags { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-tag {
    border: 1px solid rgba(255,255,255,.35);
    color: var(--white); border-radius: 50px;
    padding: 6px 14px; font-size: .78rem; font-weight: 500;
  }
  .hero-right {
    position: absolute; right: 5%; top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column; gap: 14px; z-index: 1;
  }
  .stat-card {
    background: rgba(255,255,255,.1); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 14px; padding: 14px 20px;
    display: flex; align-items: center; gap: 12px;
    min-width: 160px;
  }
  .stat-icon { font-size: 1.5rem; }
  .stat-label { font-size: .72rem; color: rgba(255,255,255,.6); }
  .stat-value { font-size: 1rem; font-weight: 700; color: var(--white); }

  /* ── SECTION TITLES ── */
  .section-title {
    text-align: center; margin-bottom: 40px;
  }
  .section-title h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700; color: var(--dark);
  }
  .section-title p { color: var(--gray); font-size: .93rem; margin-top: 6px; }
  .section-title .eyebrow {
    display: inline-block; font-size: .72rem; font-weight: 600; letter-spacing: .1em;
    text-transform: uppercase; color: var(--green); margin-bottom: 8px;
  }

  /* ── PRODUCT CAROUSELS ── */
  .products-section { padding: 64px 5%; }
  .scroll-row {
    display: flex; gap: 20px; overflow-x: auto;
    scroll-snap-type: x mandatory; padding-bottom: 12px;
    scrollbar-width: none;
  }
  .scroll-row::-webkit-scrollbar { display: none; }
  .product-card {
    flex: 0 0 220px; scroll-snap-align: start;
    background: var(--cream); border-radius: 18px;
    padding: 20px; text-align: center;
    transition: transform .2s, box-shadow .2s;
  }
  .product-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,.08); }
  .product-img {
    width: 140px; height: 140px; object-fit: contain;
    margin: 0 auto 16px; display: block;
  }
  .product-img-placeholder {
    width: 140px; height: 140px; margin: 0 auto 16px;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 3rem; background: var(--border);
  }
  .product-badge {
    font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: var(--green); background: var(--green-light);
    padding: 3px 10px; border-radius: 50px; display: inline-block; margin-bottom: 8px;
  }
  .product-name { font-size: .88rem; font-weight: 600; color: var(--dark); margin-bottom: 4px; line-height: 1.3; }
  .product-price { font-size: .9rem; color: var(--gold); font-weight: 700; margin-bottom: 12px; }
  .btn-add {
    width: 100%; background: var(--green); color: var(--white);
    border: none; border-radius: 50px; padding: 9px 0;
    font-size: .82rem; font-weight: 600; cursor: pointer; transition: background .2s;
    text-decoration: none; display: inline-block;
  }
  .btn-add:hover { background: #2e5535; }
  .btn-wa {
    width: 100%; background: #25D366; color: var(--white);
    border: none; border-radius: 50px; padding: 9px 0;
    font-size: .82rem; font-weight: 600; cursor: pointer;
    text-decoration: none; display: inline-block; transition: background .2s;
  }
  .btn-wa:hover { background: #1da851; }

  /* ── BRAND BANNER ── */
  .brand-banner {
    background: var(--cream);
    padding: 80px 5%;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  }
  .brand-tagline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15; font-weight: 900; color: var(--dark);
  }
  .brand-tagline em { color: var(--green); font-style: normal; }
  .brand-desc { color: var(--gray); line-height: 1.7; margin: 20px 0 28px; font-size: .95rem; }
  .btn-primary {
    background: var(--gold); color: var(--white);
    border: none; border-radius: 50px; padding: 13px 28px;
    font-size: .9rem; font-weight: 600; cursor: pointer; text-decoration: none;
    display: inline-block; transition: background .2s;
  }
  .btn-primary:hover { background: #a87520; }
  .brand-benefits { display: flex; flex-direction: column; gap: 20px; }
  .benefit-row { display: flex; align-items: flex-start; gap: 16px; }
  .benefit-icon {
    width: 44px; height: 44px; background: var(--green); border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; flex-shrink: 0;
  }
  .benefit-title { font-weight: 600; font-size: .93rem; margin-bottom: 4px; }
  .benefit-desc { font-size: .83rem; color: var(--gray); line-height: 1.5; }

  /* ── STORES STRIP ── */
  .stores-strip {
    padding: 36px 5%;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .stores-strip p { font-size: .8rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--gray); margin-bottom: 20px; }
  .stores-logos { display: flex; gap: 28px; align-items: center; justify-content: center; flex-wrap: wrap; }
  .store-pill {
    background: var(--cream); border: 1px solid var(--border);
    border-radius: 50px; padding: 8px 20px;
    font-size: .82rem; font-weight: 600; color: var(--dark);
  }

  /* ── NEWSLETTER ── */
  .newsletter {
    background: var(--dark); padding: 60px 5%; text-align: center;
  }
  .newsletter h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem; color: var(--white); margin-bottom: 10px;
  }
  .newsletter p { color: rgba(255,255,255,.6); margin-bottom: 28px; font-size: .92rem; }
  .newsletter-form { display: flex; gap: 10px; max-width: 440px; margin: 0 auto; }
  .newsletter-form input {
    flex: 1; border: 1px solid rgba(255,255,255,.2);
    background: rgba(255,255,255,.07); border-radius: 50px;
    padding: 12px 20px; color: var(--white); font-size: .88rem;
    outline: none;
  }
  .newsletter-form input::placeholder { color: rgba(255,255,255,.35); }
  .newsletter-form button {
    background: var(--gold); color: var(--white);
    border: none; border-radius: 50px; padding: 12px 24px;
    font-size: .85rem; font-weight: 600; cursor: pointer; white-space: nowrap;
  }

  /* ── REUSABLE SECTION ── */
  .reusable-section {
    padding: 70px 5%;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  }
  .reusable-section.reverse { direction: rtl; }
  .reusable-section.reverse > * { direction: ltr; }
  .reusable-img-box {
    background: var(--green-light); border-radius: 24px;
    height: 360px; display: flex; align-items: center; justify-content: center;
    font-size: 7rem;
  }
  .reusable-text h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 16px;
  }
  .reusable-text p { color: var(--gray); line-height: 1.7; margin-bottom: 20px; }

  /* ── INSTA GRID ── */
  .insta-section { padding: 64px 5%; }
  .insta-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px; margin-top: 32px;
  }
  .insta-cell {
    aspect-ratio: 1; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem; font-weight: 700; color: rgba(255,255,255,.6);
    overflow: hidden;
  }
  .insta-cell:nth-child(1) { background: #C8922A; font-size: 2rem; color: white; }
  .insta-cell:nth-child(2) { background: #3B6E45; }
  .insta-cell:nth-child(3) { background: #7A9E52; }
  .insta-cell:nth-child(4) { background: #D4A55C; }
  .insta-cell:nth-child(5) { background: #2e5535; }
  .insta-cell:nth-child(6) { background: #EAF2EC; color: var(--green); }
  .insta-cell:nth-child(7) { background: #F7F3EC; color: var(--gold); }
  .insta-cell:nth-child(8) { background: #1C1A14; }
  .insta-cell:nth-child(9) { background: #8B5E3C; }
  .insta-cell:nth-child(10) { background: #C8922A; }
  .insta-emoji { font-size: 3rem; }

  /* ── FOOTER ── */
  footer {
    background: var(--dark); color: var(--white);
    padding: 60px 5% 32px;
  }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px;
    margin-bottom: 48px;
  }
  .footer-brand span {
    font-family: 'Playfair Display', serif; font-size: 1.5rem;
    font-weight: 700; display: block; margin-bottom: 10px;
  }
  .footer-brand p { color: rgba(255,255,255,.5); font-size: .85rem; line-height: 1.6; max-width: 260px; }
  .footer-col h4 { font-size: .82rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.4); margin-bottom: 16px; }
  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .footer-col a { text-decoration: none; color: rgba(255,255,255,.65); font-size: .88rem; transition: color .2s; }
  .footer-col a:hover { color: var(--gold); }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,.1);
    padding-top: 24px; display: flex; justify-content: space-between; align-items: center;
  }
  .footer-bottom p { font-size: .8rem; color: rgba(255,255,255,.35); }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hero-right { display: none; }
    .brand-banner, .reusable-section { grid-template-columns: 1fr; }
    .insta-grid { grid-template-columns: repeat(3, 1fr); }
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .nav-links { display: none; }
  }
  @media (max-width: 560px) {
    .insta-grid { grid-template-columns: repeat(2, 1fr); }
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
