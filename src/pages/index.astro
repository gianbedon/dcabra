---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Categories from "../components/Categories.astro";
import ProductCarousel from "../components/ProductCarousel.astro";
import VisitUs from "../components/VisitUs.astro";
import Marquee from "../components/Marquee.astro";
import VideoShowcase from "../components/VideoShowcase.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";

// Import local assets for products
import lecheSola from "../assets/leche-sola.png";
import frutadoImg from "../assets/arandanos-frutado.png";
import griegoImg from "../assets/fresa-griego.png";

const mejoresProductos = [
  {
    name: "Leche de Cabra Entera",
    price: "S/ 10.00",
    description: "Nuestra leche de cabra pasteurizada mantiene su frescura y propiedades.",
    image: lecheSola,
  },
  {
    name: "Yogurt Frutado Arándano",
    price: "S/ 12.00",
    description: "Deliciosa combinación de yogurt de cabra y pulpa de fruta de estación.",
    image: frutadoImg,
  },
  {
    name: "Yogurt Griego + Jalea de Fresa",
    price: "S/ 8.00",
    description: "Cremoso yogurt griego de cabra acompañado de jalea artesanal de fresa.",
    image: griegoImg,
  }
];

const combosPromociones = [
  {
    name: "Leche de Cabra Entera x2",
    price: "S/ 20.00",
    description: "Lleva dos botellas de nuestra leche de cabra fresca pasteurizada a precio especial.",
    image: lecheSola,
    isCombo: true,
  },
  {
    name: "Yogurt Frutado Arándano x2",
    price: "S/ 23.00",
    description: "Disfruta el doble de sabor con dos botellas de yogurt bebible frutado natural.",
    image: frutadoImg,
    isCombo: true,
  },
  {
    name: "Yogurt Griego + Jalea de Fresa x2",
    price: "S/ 15.00",
    description: "Doble cremosidad con dos frascos de nuestro yogurt griego con jalea de fresa.",
    image: griegoImg,
    isCombo: true,
  }
];
---

<Layout title="D'Cabra – Yogurt Griego y Lácteos de Cabra 100% Naturales">
  <!-- Navbar Header -->
  <Navbar />

  <!-- Banner Hero -->
  <Hero />

  <!-- Categories Section -->
  <Categories />

  <!-- Best Products Section -->
  <ProductCarousel 
    title="Nuestras mejores productos" 
    products={mejoresProductos} 
    id="productos"
  />

  <!-- Combos & Promotions Section -->
  <ProductCarousel 
    title="Combos y Promociones" 
    products={combosPromociones} 
    id="combos"
  />

  <!-- Visit Us Section -->
  <VisitUs />

  <!-- Running Text Banner -->
  <Marquee />

  <!-- Video Showcase Player -->
  <VideoShowcase />

  <!-- Contact Us Form Section -->
  <ContactForm />

  <!-- Footer Section -->
  <Footer />
</Layout>
