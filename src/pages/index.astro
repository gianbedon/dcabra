---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Categories from "../components/Categories.astro";
import VisitUs from "../components/VisitUs.astro";
import Marquee from "../components/Marquee.astro";
import VideoShowcase from "../components/VideoShowcase.astro";

import ProductCarousel from "../components/ProductCarousel";

import { fetchGraphQL } from "@/lib/wordpress";
import { GET_CATEGORIES, GET_PRODUCTS } from "@/lib/queries";

const slugsPermitidos = [
  "yogurt-griego",
  "yogurt-frutado",
  "leche-y-yogurt-natural",
];

const categoriesData = await fetchGraphQL(GET_CATEGORIES, {
  slugs: slugsPermitidos,
});
const productsData = await fetchGraphQL(GET_PRODUCTS);

const nodosCategorias = categoriesData?.data?.categoriasDeProducto?.nodes || [];
const productos = productsData?.data?.productos?.nodes || [];

const categorias = nodosCategorias.sort(
  (a: any, b: any) =>
    slugsPermitidos.indexOf(a.slug) - slugsPermitidos.indexOf(b.slug),
);
---

<Layout title="D'Cabra – Yogurt Griego y Lácteos de Cabra 100% Naturales">
  <Hero />

  <Categories />

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-center text-primary text-4xl md:text-6xl uppercase mb-4">
        Nuestros Productos
      </h2>

      <div class="w-16 h-1 bg-primary mx-auto mb-16"></div>
      {
        categorias.map((categoria: any) => {
          const productosCategoria = productos.filter((producto: any) =>
            producto.categoriasDeProducto?.nodes?.some(
              (cat: any) => cat.slug === categoria.slug,
            ),
          );

          if (!productosCategoria.length) return null;

          return (
            <ProductCarousel
              client:visible
              title={categoria.name}
              products={productosCategoria}
            />
          );
        })
      }
    </div>
  </section>
  <VisitUs />

  <Marquee />

  <VideoShowcase />
</Layout>
