---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import Navbar from "../../components/Navbar.astro";
import ContactForm from "../../components/ContactForm.astro";
import Footer from "../../components/Footer.astro";


// ── Hero ─────────────────────────────────────────────────────────
import fondoGriego from "../../assets/fondo-griego.jpg";

// ── Recetas (fotos) ───────────────────────────────────────────────
import receta1 from "../../assets/yogurt-griego-con-cuchara.jpg";
import receta2 from "../../assets/leche-beneficios.jpg";
import receta3 from "../../assets/fondo-leche.jpeg";
import receta4 from "../../assets/portada-chacrita.jpg";
import receta5 from "../../assets/cabra-campo-historia.jpg";
import receta6 from "../../assets/feria_stand.png";

// ── Productos carousel ────────────────────────────────────────────
import lecheSola       from "../../assets/leche-sola.png";
import fresaGriego     from "../../assets/fresa-griego.png";
import mangoGriego     from "../../assets/mango-griego.png";
import maracumangoGriego from "../../assets/maracumango-griego.png";
import arandanoGriego  from "../../assets/arandano-griego.png";
import fresaFrutado    from "../../assets/fresa-frutado.png";
import mangoFrutado    from "../../assets/mango-frutado.png";
import arandanosFrutado from "../../assets/arandanos-frutado.png";
import quesoCabra      from "../../assets/queso_cabra.png";

const whatsAppPhone = "51900154196";

function makeWAUrl(product: string, price: string) {
  const text = encodeURIComponent(
    `Hola D'Cabra! 🐐 Deseo comprar:\n📦 *${product}*\n💰 Precio: *${price}*\n\n¿Podrían brindarme información para concretar el pedido? ¡Gracias!`
  );
  return `https://wa.me/${whatsAppPhone}?text=${text}`;
}

// ── Data ──────────────────────────────────────────────────────────
const recetas = [
  {
    img: receta1,
    title: "Bowl de Yogurt Griego con Granola",
    desc: "Un desayuno cremoso y nutritivo con yogurt griego de cabra, granola crujiente, frutas frescas y miel.",
  },
  {
    img: receta2,
    title: "Batido Energético de Leche de Cabra",
    desc: "Batido proteico con leche de cabra fresca, plátano, cacao puro y avena. Ideal post-entrenamiento.",
  },
  {
    img: receta3,
    title: "Smoothie Tropical con Yogurt Frutado",
    desc: "Refrescante smoothie de yogurt frutado de cabra con mango, maracuyá y leche de coco.",
  },
  {
    img: receta4,
    title: "Postre de Yogurt Griego con Miel",
    desc: "Sencillo y delicioso: yogurt griego de cabra con chorro de miel artesanal y nueces tostadas.",
  },
  {
    img: receta5,
    title: "Parfait de Arándanos y Queso",
    desc: "Capas de yogurt griego, arándanos frescos y queso de cabra suave. Un postre elegante y saludable.",
  },
  {
    img: receta6,
    title: "Helado Cremoso de Yogurt",
    desc: "Helado artesanal preparado con yogurt griego de cabra, fresas y un toque de vainilla natural.",
  },
];

const productos = [
  {
    img: arandanosFrutado,
    title: "Yogurt Frutado · Arándano",
    price: "S/ 12.00",
    desc: "Arándanos frescos con yogurt de cabra.",
  },
  {
    img: fresaGriego,
    title: "Yogurt Griego · Fresa",
    price: "S/ 8.00",
    desc: "Cremoso yogurt griego con jalea artesanal de fresa.",
  },
  {
    img: lecheSola,
    title: "Leche de Cabra Natural",
    price: "S/ 14.00",
    desc: "100% pura, pasteurizada y lista para consumir.",
  },
  {
    img: mangoGriego,
    title: "Yogurt Griego · Mango",
    price: "S/ 8.00",
    desc: "Tropical y cremoso, con jalea de mango seleccionado.",
  },
  {
    img: fresaFrutado,
    title: "Yogurt Frutado · Fresa",
    price: "S/ 12.00",
    desc: "Pulpa de fresas naturales en yogurt bebible de cabra.",
  },
  {
    img: maracumangoGriego,
    title: "Yogurt Griego · Maracumango",
    price: "S/ 8.00",
    desc: "La exótica fusión de maracuyá y mango en yogurt griego.",
  },
  {
    img: mangoFrutado,
    title: "Yogurt Frutado · Mango",
    price: "S/ 12.00",
    desc: "Frescura tropical: mango natural en yogurt bebible de cabra.",
  },
  {
    img: arandanoGriego,
    title: "Yogurt Griego · Arándano",
    price: "S/ 8.00",
    desc: "Yogurt griego con generosa jalea de arándanos frescos.",
  },
  {
    img: quesoCabra,
    title: "Queso de Cabra Natural",
    price: "S/ 24.00",
    desc: "Queso artesanal suave, elaborado con leche de cabra fresca.",
  },
