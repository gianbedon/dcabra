---
import Layout from "../../layouts/Layout.astro";
import cabritasCampo from '../../assets/cabritas-campo.png';
import Image from "astro/components/Image.astro";
import leches from '../../assets/leches.png';
import { Image } from 'astro:assets';

---

<Layout>
<h1>
   <!-- ── ICONOS DE BENEFICIOS ── -->
<section class="bg-white py-8 px-4">
  <div class="max-w-4xl mx-auto flex flex-wrap justify-center gap-6">

    <!-- Calorías -->
    <div class="flex flex-col items-center gap-2">
      <div class="bg-primary rounded-2xl p-4 w-20 h-20 flex items-center justify-center shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.047 8.287 8.287 0 009 9.608a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.473z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.545 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z"/>
        </svg>
      </div>
      <span class="font-bold text-primary text-sm text-center">Calorías</span>
    </div>

    <!-- Proteínas -->
    <div class="flex flex-col items-center gap-2">
      <div class="bg-primary rounded-2xl p-4 w-20 h-20 flex items-center justify-center shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"/>
        </svg>
      </div>
      <span class="font-bold text-primary text-sm text-center">Proteínas</span>
    </div>

    <!-- Calcio -->
    <div class="flex flex-col items-center gap-2">
      <div class="bg-primary rounded-2xl p-4 w-20 h-20 flex items-center justify-center shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          <text x="12" y="13" text-anchor="middle" font-size="6" fill="white" stroke="none" font-weight="bold">Ca</text>
        </svg>
      </div>
      <span class="font-bold text-primary text-sm text-center">Calcio</span>
    </div>

    <!-- Potasio -->
    <div class="flex flex-col items-center gap-2">
      <div class="bg-primary rounded-2xl p-4 w-20 h-20 flex items-center justify-center shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
        </svg>
      </div>
      <span class="font-bold text-primary text-sm text-center">Potasio</span>
    </div>

    <!-- Vitamina A -->
    <div class="flex flex-col items-center gap-2">
      <div class="bg-primary rounded-2xl p-4 w-20 h-20 flex items-center justify-center shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
        </svg>
      </div>
      <span class="font-bold text-primary text-sm text-center">Vitamina A</span>
    </div>

  </div>
</section>

<!-- ── SECCIÓN NOSOTROS ── -->
<section class="bg-white py-16 px-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12">

    <!-- Texto izquierda -->
    <div class="flex-1">
      <h2 class="text-primary text-4xl md:text-5xl mb-1">Nosotros</h2>
      <div class="bg-primary text-white text-lg  px-3 py-1 inline-block mb-6 rounded-sm">
        Pasión por lo Natural
      </div>

      <p class="text-gray-800 mb-4">
        <strong>D'Cabra nació de un sueño simple:</strong><br/>
        Volver a lo básico y ofrecer a las familias una alternativa láctea que fuera a la vez nutritiva y deliciosa. 
        Fundada en los verdes campos de nuestra región de <strong>Huaura – Huacho,</strong> nuestro establo fue fundado 
        con el propósito de poder dar una alternativa sostenible de <strong>productos lácteos 100% naturales</strong> y 
        generar la confianza al cliente del producto que lleva a su mesa, ya que cada producto elaborado por D'Cabra 
        está elaborado con los mejores ingredientes.
      </p>

      <a href="https://dcabra.vercel.app/nuestra-historia"
   class="inline-block bg-primary text-white font-semibold px-6 py-2 rounded-lg hover:bg-primary/90 transition-colors">
  Ver más
</a>
    </div>

    <!-- Imagen derecha -->
    <div class="flex-1 flex justify-center">
      <Image
        src={cabritasCampo}
        alt="Cabritas en el campo D'Cabra"
        class="rounded-3xl w-full max-w-lg object-cover shadow-lg"
      />
    </div>

  </div>
</section>


<!-- ── ¿POR QUÉ D'CABRA? ── -->
<section class="bg-white py-16 px-6">
  <div class="max-w-5xl mx-auto border border-gray-200 rounded-3xl shadow-sm py-12 px-8">

    <h2 class="text-primary text-center text-4xl md:text-5xl mb-3">¿Por qué D'Cabra?</h2>
    <p class="text-center font-bold text-gray-700 mb-12">
      Compromiso absoluto con la pureza y el bienestar desde el origen.
    </p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">

      <!-- Fácil Digestión -->
      <div class="flex flex-col items-center text-center gap-3">
        <div class="w-24 h-24 rounded-full border-2 border-primary flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
          </svg>
        </div>
        <span class="bg-primary text-white text-xs font-bold px-3 py-1 rounded-full">Fácil Digestión</span>
        <p class="text-gray-600 text-xs leading-relaxed">
          Naturalmente menos ligera gracias a partículas de grasa más pequeñas y menos lactosa.
        </p>
      </div>

      <!-- Origen 100% Natural -->
      <div class="flex flex-col items-center text-center gap-3">
        <div class="w-24 h-24 rounded-full border-2 border-primary flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v.01M12 10v.01M12 14v.01"/>
          </svg>
        </div>
        <span class="bg-primary text-white text-xs font-bold px-3 py-1 rounded-full">Origen 100% Natural</span>
        <p class="text-gray-600 text-xs leading-relaxed">
          Sin conservantes ni añadidos. Directo de nuestras granjas familiares a tu hogar.
        </p>
      </div>

      <!-- Rica en Nutrientes -->
      <div class="flex flex-col items-center text-center gap-3">
        <div class="w-24 h-24 rounded-full border-2 border-primary flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
          </svg>
        </div>
        <span class="bg-primary text-white text-xs font-bold px-3 py-1 rounded-full">Rica en Nutrientes</span>
        <p class="text-gray-600 text-xs leading-relaxed">
          Alto contenido de calcio, proteínas y minerales esenciales para el crecimiento.
        </p>
      </div>

      <!-- Libre Pastoreo -->
      <div class="flex flex-col items-center text-center gap-3">
        <div class="w-24 h-24 rounded-full border-2 border-primary flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"/>
          </svg>
        </div>
        <span class="bg-primary text-white text-xs font-bold px-3 py-1 rounded-full">Libre Pastoreo</span>
        <p class="text-gray-600 text-xs leading-relaxed">
          Viven libremente por extensiones de terreno abierto para alimentarse de verduras, pastos, arbustos y hojas.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- ── LECHE ENTERA PASTEURIZADA ── -->
<section class="bg-white py-16 px-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12">

    <!-- Texto izquierda -->
    <div class="flex-1">
      <p class="italic text-gray-500 text-xl mb-1" style="font-family: cursive;">Disfruta tu</p>
      <h2 class="text-primary text-4xl md:text-5xl uppercase leading-tight mb-2">
        Leche Entera
      </h2>
      <h5 class="bg-primary text-white uppercase px-3 py-1 inline-block rounded-sm text-lg mb-6">
        Pasteurizada
      </h5>

      <p class="text-gray-800 mb-4">
        <strong>La leche de cabra</strong> es naturalmente fácil de digerir porque tiene partículas de grasa más pequeñas y
        menos lactosa que la leche de vaca. Es una gran opción para muchas personas, incluidas aquellas con estómagos sensibles.
      </p>
      <p class="text-gray-800 mb-8">
        Nuestras cabras felices son criadas en granjas familiares, asegurando una leche nutritiva y de alta calidad.
      </p>

      <!-- Valor Nutricional -->
      <p class="italic text-primary text-2xl mb-1" style="font-family: cursive;">Valor Nutricional</p>
      <p class="text-gray-500 text-sm mb-6">Valores aproximados por envase (900ml).</p>

      <div class="flex gap-6 flex-wrap">

        <!-- Calorías -->
        <div class="flex flex-col items-center gap-1">
          <div class="bg-primary rounded-xl p-2 w-12 h-12 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.047 8.287 8.287 0 009 9.608a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.473z"/>
            </svg>
          </div>
          <span class="font-bold text-gray-800 text-xs">Calorías</span>
          <span class="text-gray-500 text-xs">168</span>
        </div>

        <!-- Proteínas -->
        <div class="flex flex-col items-center gap-1">
          <div class="bg-primary rounded-xl p-2 w-12 h-12 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"/>
            </svg>
          </div>
          <span class="font-bold text-gray-800 text-xs">Proteínas</span>
          <span class="text-gray-500 text-xs">34g</span>
        </div>

        <!-- Calcio -->
        <div class="flex flex-col items-center gap-1">
          <div class="bg-primary rounded-xl p-2 w-12 h-12 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="font-bold text-gray-800 text-xs">Calcio</span>
          <span class="text-gray-500 text-xs">327 mg</span>
        </div>

        <!-- Potasio -->
        <div class="flex flex-col items-center gap-1">
          <div class="bg-primary rounded-xl p-2 w-12 h-12 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
            </svg>
          </div>
          <span class="font-bold text-gray-800 text-xs">Potasio</span>
          <span class="text-gray-500 text-xs">498 mg</span>
        </div>

        <!-- Vitamina A -->
        <div class="flex flex-col items-center gap-1">
          <div class="bg-primary rounded-xl p-2 w-12 h-12 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
            </svg>
          </div>
          <span class="font-bold text-gray-800 text-xs">Vitamina A</span>
          <span class="text-gray-500 text-xs">483 IU</span>
        </div>

      </div>
    </div>

    <!-- Imagen derecha -->
    <div class="flex-1 flex justify-center">
      <Image
        src={leches}
        alt="Leche Entera Pasteurizada D'Cabra"
        class="w-full max-w-lg object-contain"
      />
    </div>

  </div>
</section>
</h1>

</Layout>
