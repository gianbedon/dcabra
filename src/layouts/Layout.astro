---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "D'Cabra – Lácteos de Cabra 100% Naturales",
  description = "Yogurt griego, leche de cabra y más. Productos artesanales sin azúcar añadida, con probióticos naturales. Directo desde nuestra granja hasta tu mesa.",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>