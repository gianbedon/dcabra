---
// ContactForm.astro
// Configurable WhatsApp target number for form submission
const whatsAppPhone = "51900154196";
---

<section
  id="contacto"
  class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24"
>
  <div
    class="relative bg-white border border-gray-150 rounded-[2.5rem] shadow-xl overflow-hidden p-8 sm:p-12 md:p-16"
  >
    <!-- Goat Head SVG Silhouette watermark in the background (Right side) -->
    <div
      class="absolute right-0 bottom-0 top-0 w-1/3 opacity-[0.03] pointer-events-none hidden md:flex items-center justify-end pr-10"
    >
      <svg
        class="w-full h-auto text-primary"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <!-- Goat head silhouette path -->
        <path
          d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15.5c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5.67-1.5 1.5-1.5 1.5.67 1.5 1.5zm-1.5-3.5c-.55 0-1-.45-1-1V8c0-.55.45-1 1-1s1 .45 1 1v5c0 .55-.45 1-1 1zm5.28-4.84l-2.52-2.52c-.39-.39-1.02-.39-1.41 0-.39.39-.39 1.02 0 1.41l1.81 1.81-1.81 1.81c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l2.52-2.52c.39-.38.39-1.01 0-1.4z"
        ></path>
      </svg>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-3xl mx-auto">
      <h3
        class="text-primary text-3xl sm:text-4xl text-center uppercase tracking-wider mb-12"
      >
        Contáctanos
      </h3>

      <form id="whatsapp-contact-form" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- NOMBRE -->
          <div class="flex flex-col gap-2">
            <label
              for="form-nombre"
              class="text-primary text-xs uppercase tracking-wider ml-1"
            >
              Nombre
            </label>
            <input
              type="text"
              id="form-nombre"
              name="nombre"
              required
              placeholder="Ingresa tu nombre completo"
              class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-gray-200 text-gray-800 text-sm font-semibold placeholder-gray-400 focus:bg-white focus:border-primary focus:ring-3 focus:ring-primary/10 transition-all duration-300 outline-hidden"
            />
          </div>

          <!-- CELULAR -->
          <div class="flex flex-col gap-2">
            <label
              for="form-celular"
              class="text-primary text-xs uppercase tracking-wider ml-1"
            >
              Celular
            </label>
            <input
              type="tel"
              id="form-celular"
              name="celular"
              required
              placeholder="Ej. 987654321"
              class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-gray-200 text-gray-800 text-sm font-semibold placeholder-gray-400 focus:bg-white focus:border-primary focus:ring-3 focus:ring-primary/10 transition-all duration-300 outline-hidden"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- PRODUCTO -->
          <div class="flex flex-col gap-2">
            <label
              for="form-producto"
              class="text-primary text-xs uppercase tracking-wider ml-1"
            >
              Producto
            </label>
            <div class="relative">
              <select
                id="form-producto"
                name="producto"
                required
                class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-gray-200 text-gray-800 text-sm font-semibold focus:bg-white focus:border-primary focus:ring-3 focus:ring-primary/10 transition-all duration-300 outline-hidden appearance-none cursor-pointer"
              >
                <option value="" disabled selected
                  >Selecciona un producto</option
                >
                <option value="Leche de Cabra">Leche de Cabra</option>
                <option value="Yogurt Griego">Yogurt Griego</option>
                <option value="Yogurt Griego + Jalea"
                  >Yogurt Griego + Jalea</option
                >
                <option value="Yogurt Natural">Yogurt Natural</option>
                <option value="Yogurt Natural + Fruta"
                  >Yogurt Natural + Fruta</option
                >
              </select>
              <!-- Select arrow indicator -->
              <div
                class="absolute inset-y-0 right-0 flex items-center pr-6 pointer-events-none text-primary"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>
          </div>

          <!-- CANTIDAD -->
          <div class="flex flex-col gap-2">
            <label
              for="form-cantidad"
              class="text-primary text-xs uppercase tracking-wider ml-1"
            >
              Cantidad
            </label>
            <input
              type="number"
              id="form-cantidad"
              name="cantidad"
              required
              min="1"
              value="1"
              placeholder="Cantidad"
              class="w-full px-6 py-4 rounded-2xl bg-gray-50 border border-gray-200 text-gray-800 text-sm font-semibold focus:bg-white focus:border-primary focus:ring-3 focus:ring-primary/10 transition-all duration-300 outline-hidden"
            />
          </div>
        </div>

        <!-- Submit Button -->
        <button
  id="btn-whatsapp"
  type="button"
  class="w-full py-4 bg-green-500 text-white font-black rounded-xl hover:bg-green-600 transition-colors text-lg flex items-center justify-center gap-2"
>
  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.122 1.528 5.855L.057 23.998l6.304-1.654A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.36-.214-3.732.979 1.001-3.648-.235-.374A9.818 9.818 0 1112 21.818z"/>
  </svg>
  Pedir por WhatsApp
</button>
      </form>
    </div>
  </div>
</section>

<script>
  document.getElementById("btn-whatsapp")?.addEventListener("click", () => {
    const nombre = (document.getElementById("form-nombre") as HTMLInputElement).value.trim();
    const celular = (document.getElementById("form-celular") as HTMLInputElement).value.trim();
    const producto = (document.getElementById("form-producto") as HTMLSelectElement).value;
    const cantidad = (document.getElementById("form-cantidad") as HTMLInputElement).value;

    if (!nombre || !producto) {
      alert("Por favor completa tu nombre y selecciona un producto.");
      return;
    }

    const mensaje = `Hola D'Cabra! 🐐\n\n*Nombre:* ${nombre}\n*Celular:* ${celular}\n*Producto:* ${producto}\n*Cantidad:* ${cantidad}\n\n¿Me pueden confirmar el pedido? ¡Gracias!`;
    const url = `https://wa.me/51900154196?text=${encodeURIComponent(mensaje)}`;
    window.open(url, "_blank");
  });
</script>
