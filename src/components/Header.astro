---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

// Define navigation links
const navLinks = [
  { href: "/", label: "Inicio", active: true },
  { href: "#productos", label: "Productos", active: false },
  { href: "#nosotros", label: "Nuestra historia", active: false },
];
---

<header
  class="fixed top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-100 shadow-sm transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo Section -->
      <a
        href="/"
        class="flex items-center gap-2 group focus:outline-hidden"
        aria-label="D'Cabra Home"
      >
        <Image
          src={logo}
          alt="D'Cabra Logo"
          width={120}
          height={50}
          class="h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav
        class="hidden md:flex items-center gap-8"
        aria-label="Desktop Navigation"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class={`relative py-2 text-[15px] font-medium transition-colors duration-300 focus:outline-hidden ${
                link.active
                  ? "text-primary font-semibold"
                  : "text-gray-600 hover:text-primary"
              } group`}
            >
              {link.label}
              <span
                class={`absolute bottom-0 left-0 w-full h-[2px] bg-primary transition-transform duration-300 origin-left ${
                  link.active
                    ? "scale-x-100"
                    : "scale-x-0 group-hover:scale-x-100"
                }`}
              />
            </a>
          ))
        }
      </nav>

      <!-- CTA Button (optional but adds premium feel) -->
      <div class="hidden md:flex items-center">
        <a
          href="#contacto"
          class="px-5 py-2.5 rounded-full text-sm font-semibold bg-primary text-white shadow-md shadow-primary/20 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/30 transition-all duration-300 hover:-translate-y-0.5 focus:outline-hidden"
        >
          Contacto
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex items-center justify-center p-2.5 rounded-xl text-gray-500 hover:text-primary hover:bg-gray-50 focus:outline-hidden transition-all duration-300"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle main menu"
        >
          <!-- Menu Icon -->
          <svg
            id="hamburger-icon"
            class="block h-6 w-6 transition-transform duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <!-- Close Icon -->
          <svg
            id="close-icon"
            class="hidden h-6 w-6 transition-transform duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden overflow-hidden bg-white border-t border-gray-100 transition-all duration-300 ease-in-out max-h-0"
    aria-label="Mobile Navigation"
  >
    <div class="px-4 pt-3 pb-6 space-y-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`block px-4 py-3 rounded-xl text-base font-medium transition-all duration-300 ${
              link.active
                ? "bg-primary/5 text-primary font-semibold"
                : "text-gray-600 hover:bg-gray-50 hover:text-primary"
            }`}
          >
            {link.label}
          </a>
        ))
      }
      <div class="pt-4 border-t border-gray-100 px-4">
        <a
          href="#contacto"
          class="block w-full py-3 text-center rounded-xl text-base font-semibold bg-primary text-white shadow-md shadow-primary/20 hover:bg-primary/90 transition-all duration-300"
        >
          Contacto
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";

      // Toggle accessibility states
      toggleBtn.setAttribute("aria-expanded", String(!isExpanded));

      if (!isExpanded) {
        // Opening menu
        mobileMenu.classList.remove("hidden");
        // Trigger reflow for transition
        void mobileMenu.offsetHeight;

        mobileMenu.style.maxHeight = `${mobileMenu.scrollHeight}px`;
        mobileMenu.classList.add("opacity-100");

        hamburgerIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
      } else {
        // Closing menu
        mobileMenu.style.maxHeight = "0";
        mobileMenu.classList.remove("opacity-100");

        hamburgerIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");

        // Hide after transition ends
        const handleTransitionEnd = () => {
          mobileMenu.classList.add("hidden");
          mobileMenu.removeEventListener("transitionend", handleTransitionEnd);
        };
        mobileMenu.addEventListener("transitionend", handleTransitionEnd);
      }
    });

    // Close menu when window is resized above mobile breakpoint
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        mobileMenu.classList.add("hidden");
        mobileMenu.style.maxHeight = "";
        toggleBtn.setAttribute("aria-expanded", "false");
        hamburgerIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      }
    });
  }
</script>

<style>
  /* Extra styling if needed - utilizing tailwind for most things */
  #mobile-menu {
    transition:
      max-height 0.3s ease-in-out,
      opacity 0.2s ease-in-out;
  }
</style>
