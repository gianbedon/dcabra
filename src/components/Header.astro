---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/producto", label: "Productos" },
  { href: "/historia", label: "Nuestra historia" },

];
---

<header class="fixed top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-20">

    <a
          href="/"
          class="flex items-center gap-2 bg-white/10 p-3 rounded-2xl border border-white/20 hover:bg-white/20 transition-all duration-300"
        >
          <Image
            src={logo}
            alt="D'Cabra Logo"
            width={120}
            height={50}
            class="h-10 w-auto object-contain"
          />
        </a>

    <nav class="hidden md:flex items-center gap-10">
      {navLinks.map(link => (
        <a href={link.href} class="text-sm font-semibold text-gray-700 hover:text-purple-700 transition-colors duration-200 tracking-wide uppercase">
          {link.label}
        </a>
      ))}
    </nav>

    <a href="#contacto" class="hidden md:inline-flex px-6 py-2.5 rounded-full bg-purple-700 text-white text-sm font-bold hover:bg-purple-800 transition-colors duration-200">
      Contacto
    </a>

    <button id="menu-btn" class="md:hidden p-2 text-gray-700">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-6 py-4 space-y-3">
    {navLinks.map(link => (
      <a href={link.href} class="block text-sm font-semibold text-gray-700 hover:text-purple-700 uppercase">{link.label}</a>
    ))}
    <a href="#contacto" class="block text-center mt-2 px-6 py-2.5 rounded-full bg-purple-700 text-white text-sm font-bold">Contacto</a>
  </div>
</header>

<script>
  document.getElementById("menu-btn")?.addEventListener("click", () => {
    document.getElementById("mobile-menu")?.classList.toggle("hidden");
  });
</script>