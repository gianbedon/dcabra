---
import cabrasHistoria from "../assets/cabra-campo-historia.jpg";
---

<section class="relative bg-white select-none overflow-hidden py-16">
  <div class="w-full">
    <div
      class="relative w-full h-[300px] sm:h-[400px] md:h-[500px] lg:h-[830px] overflow-hidden shadow-2xl"
    >
      <video
        id="historiaVideo"
        class="w-full h-full object-cover"
        src="/videos/video-web-evento.mp4"
        poster={cabrasHistoria.src}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Video Establo D'Cabra"
      >
      </video>

      <div
        class="absolute top-0 left-0 w-full h-[90px] md:h-[120px] overflow-hidden z-20 pointer-events-none"
      >
        <div class="wave-track absolute top-0 left-0 flex w-[200%] h-full">
          <svg
            class="w-1/2 h-full flex-none"
            viewBox="0 0 1200 120"
            preserveAspectRatio="none"
          >
            <path
              d="M0,0 H1200 V55 C1050,110 930,20 780,55 C620,92 520,110 360,55 C220,10 120,110 0,55 Z"
              fill="white"></path>
          </svg>

          <svg
            class="w-1/2 h-full flex-none"
            viewBox="0 0 1200 120"
            preserveAspectRatio="none"
          >
            <path
              d="M0,0 H1200 V55 C1050,110 930,20 780,55 C620,92 520,110 360,55 C220,10 120,110 0,55 Z"
              fill="white"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById(
    "historiaVideo",
  ) as HTMLVideoElement | null;

  if (video) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      },
      {
        threshold: 0.4,
      },
    );

    observer.observe(video);
  }
</script>

<style>
  .wave-track {
    animation: waveMove 10s linear infinite;
  }

  @keyframes waveMove {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }
</style>
