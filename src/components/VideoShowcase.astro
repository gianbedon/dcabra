---
import { Image } from "astro:assets";
import cabrasHistoria from "../assets/cabra-campo-historia.jpg";
---

<section class="py-12 bg-white select-none">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Outer Video Container with thick border and shadow -->
    <div class="relative bg-white border-4 border-white ring-4 ring-primary/25 rounded-3xl overflow-hidden shadow-2xl aspect-video group cursor-pointer">
      
      <!-- Video Thumbnail Image -->
      <Image 
        src={cabrasHistoria} 
        alt="Establo D'Cabra Video" 
        class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-102"
      />
      
      <!-- Purple Overlay -->
      <div class="absolute inset-0 bg-primary/20 group-hover:bg-primary/10 transition-colors duration-300"></div>
      
      <!-- Centered Play Button -->
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-20 h-20 bg-white/95 rounded-full flex items-center justify-center shadow-2xl group-hover:scale-110 transition-all duration-300">
          <svg class="w-10 h-10 text-primary ml-1.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>
      
    </div>
  </div>
</section>
