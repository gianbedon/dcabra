---
import { Image } from "astro:assets";

interface Product {
  name: string;
  price: string;
  description: string;
  image: ImageMetadata;
  isCombo?: boolean;
}

interface Props {
  title: string;
  products: Product[];
  id: string;
}

const { title, products, id } = Astro.props;
const whatsAppPhone = "51900154196";
---

<section id={id} class="py-16 bg-white select-none relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <h2 class="text-primary text-3xl sm:text-5xl uppercase tracking-wider text-center mb-12">
      {title}
    </h2>

    <!-- Carousel Wrapper -->
    <div class="relative flex items-center">
      <!-- Scroll Row -->
      <div 
        id={`scroll-${id}`} 
        class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory py-4 px-2 w-full scrollbar-none"
        style="scrollbar-width: none;"
      >
        {products.map((prod) => {
          // Custom WhatsApp message
          const whatsappText = encodeURIComponent(
            `Hola D'Cabra! 🐐 Deseo comprar:\n📦 *${prod.name}*\n💰 Precio: *${prod.price}*\n\n¿Podrían brindarme información para concretar el pedido? ¡Gracias!`
          );
          const whatsappUrl = `https://wa.me/${whatsAppPhone}?text=${whatsappText}`;

          return (
            <div class="flex-none w-[280px] sm:w-[320px] snap-start bg-white rounded-2xl border border-gray-150 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col p-5 group">
              <!-- Image Container -->
              <div class="bg-white rounded-xl h-56 flex items-center justify-center relative overflow-hidden mb-4 p-4 shrink-0">
                {prod.isCombo ? (
                  /* Combo Mode: Two overlapping images */
                  <div class="relative flex items-center justify-center w-full h-full">
                    <Image 
                      src={prod.image} 
                      alt={prod.name} 
                      class="h-44 w-auto object-contain transform -translate-x-4 drop-shadow-md transition-transform duration-300 group-hover:scale-102"
                    />
                    <Image 
                      src={prod.image} 
                      alt={prod.name} 
                      class="h-44 w-auto object-contain transform translate-x-4 -ml-24 drop-shadow-md transition-transform duration-300 group-hover:scale-102"
                    />
                    <!-- Badge x2 -->
                    <div class="absolute top-2 right-4 w-10 h-10 bg-primary text-white text-sm font-black rounded-full flex items-center justify-center border-2 border-white shadow-md z-10 animate-bounce">
                      x2
                    </div>
                  </div>
                ) : (
                  /* Single Product Mode */
                  <Image 
                    src={prod.image} 
                    alt={prod.name} 
                    class="h-48 w-auto object-contain drop-shadow-md transition-transform duration-300 group-hover:scale-105"
                  />
                )}
              </div>

              <!-- Product Details -->
              <div class="flex flex-col flex-1">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <h4 class="text-gray-900 text-sm sm:text-base leading-tight">
                    {prod.name}
                  </h4>
                  <span class="text-primary font-black text-sm sm:text-base shrink-0">
                    {prod.price}
                  </span>
                </div>
                
                <p class="text-gray-500 text-xs sm:text-sm leading-relaxed mb-6 font-medium flex-1">
                  {prod.description}
                </p>

                <!-- WhatsApp CTA Button -->
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-3 px-4 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs sm:text-sm text-center shadow-xs transition-all duration-300 flex items-center justify-center gap-2"
                >
                  Pedir por WhatsApp
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Arrow Indicator Right -->
      <button 
        id={`btn-next-${id}`}
        class="absolute -right-4 bg-primary text-white p-3 rounded-full shadow-md z-10 hover:bg-primary-dark transition-all hidden md:flex items-center justify-center transform translate-x-1/2 cursor-pointer focus:outline-hidden"
        aria-label="Next items"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script is:inline define:vars={{ id }}>
  const scrollRow = document.getElementById(`scroll-${id}`);
  const nextBtn = document.getElementById(`btn-next-${id}`);

  nextBtn?.addEventListener('click', () => {
    if (scrollRow) {
      const cardWidth = 320 + 24; // Card width + gap
      scrollRow.scrollBy({ left: cardWidth, behavior: 'smooth' });
    }
  });
</script>
