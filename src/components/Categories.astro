---
import { Image } from "astro:assets";
import lecheImg from "../assets/leche-sola.png";
import frutadoImg from "../assets/arandanos-frutado.png";
import griegoImg from "../assets/griego-solo.png";
import quesoImg from "../assets/queso_cabra.png";

const categories = [
  { name: "Leche", image: lecheImg, alt: "Leche de Cabra" },
  { name: "Yogurt Frutado", image: frutadoImg, alt: "Yogurt Frutado" },
  { name: "Yogurt Griego", image: griegoImg, alt: "Yogurt Griego" },
  { name: "QUESOS", image: quesoImg, alt: "Quesos de Cabra" },
];
---

<section class="py-16 bg-white select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="block text-gray-500 font-semibold text-lg tracking-wide mb-1 font-sans">Descubre</span>
    <h2 class="text-primary text-4xl sm:text-5xl uppercase tracking-wider mb-12">
      Nuestras Categorías
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 max-w-4xl mx-auto">
      {categories.map((cat) => (
        <div class="flex flex-col items-center group">
          <!-- Card Container -->
          <div class="bg-white border-3 border-primary rounded-3xl w-full aspect-3/4 flex items-center justify-center p-6 shadow-sm hover:shadow-md transition-all duration-300 transform group-hover:-translate-y-1">
            <Image 
              src={cat.image} 
              alt={cat.alt} 
              class="max-h-[160px] md:max-h-[180px] w-auto object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <!-- Label Pill -->
          <div class="bg-primary hover:bg-primary-dark text-white font-bold text-sm sm:text-base py-2.5 px-6 rounded-full -mt-5 z-10 shadow-md transition-colors duration-200 uppercase tracking-wide min-w-[120px] sm:min-w-[140px] text-center">
            {cat.name}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
