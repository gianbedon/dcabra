---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
---

<footer
  id="nosotros"
  class="bg-primary text-white pt-16 pb-8 select-none border-t border-primary-dark/20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      
      <!-- Brand & Info Column -->
      <div class="col-span-1 md:col-span-4 flex flex-col items-start gap-4">
        <a href="#" class="flex items-center">
          <Image
            src={logo}
            alt="D'Cabra Logo"
            class="h-12 w-auto object-contain brightness-0 invert"
          />
        </a>
        <p class="text-white/70 text-sm leading-relaxed max-w-xs font-sans mt-2">
          Sano y nutritivo como nuestra gran familia de productos de cabra. Tradición artesanal en tu mesa.
        </p>
      </div>

      <!-- Links Column: PRODUCTOS -->
      <div class="col-span-1 md:col-span-2.5">
        <h4 class="text-white font-extrabold text-sm uppercase tracking-wider mb-5">
          Productos
        </h4>
        <ul class="space-y-3 font-sans">
          <li>
            <a href="#productos" class="text-white/75 hover:text-white text-sm transition-colors duration-200">
              Leche
            </a>
          </li>
          <li>
            <a href="#productos" class="text-white/75 hover:text-white text-sm transition-colors duration-200">
              Yogurt Griego
            </a>
          </li>
          <li>
            <a href="#productos" class="text-white/75 hover:text-white text-sm transition-colors duration-200">
              Yogurt Frutado
            </a>
          </li>
          <li>
            <a href="#productos" class="text-white/75 hover:text-white text-sm transition-colors duration-200">
              Queso
            </a>
          </li>
        </ul>
      </div>

      <!-- Links Column: NOSOTROS -->
      <div class="col-span-1 md:col-span-2.5">
        <h4 class="text-white font-extrabold text-sm uppercase tracking-wider mb-5">
          Nosotros
        </h4>
        <ul class="space-y-3 font-sans">
          <li>
            <a href="#visitanos" class="text-white/75 hover:text-white text-sm transition-colors duration-200">
              Nuestra Historia
            </a>
          </li>
          <li>
            <a href="#visitanos" class="text-white/75 hover:text-white text-sm transition-colors duration-200">
              Puntos de Venta
            </a>
          </li>
          <li>
            <a href="#" class="text-white/75 hover:text-white text-sm transition-colors duration-200">
              Trabaja con Nosotros
            </a>
          </li>
        </ul>
      </div>

      <!-- Links Column: REDES SOCIALES -->
      <div class="col-span-1 md:col-span-3">
        <h4 class="text-white font-extrabold text-sm uppercase tracking-wider mb-5">
          Redes Sociales
        </h4>
        <ul class="space-y-4 font-sans">
          <!-- Instagram -->
          <li>
            <a
              href="https://www.instagram.com/dcabraperu/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-white/75 hover:text-white text-sm transition-colors duration-200 group"
            >
              <span class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-white/20 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
                </svg>
              </span>
              @dcabra.pe
            </a>
          </li>
          <!-- Facebook -->
          <li>
            <a
              href="https://www.facebook.com/dcabraperu"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-white/75 hover:text-white text-sm transition-colors duration-200 group"
            >
              <span class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-white/20 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M9 8H7v3h2v9h3v-9h2.72l.42-3H12V6c0-.53.47-1 1-1h3V2h-3c-2.76 0-5 2.24-5 5v1z"></path>
                </svg>
              </span>
              /dcabra.pe
            </a>
          </li>
          <!-- TikTok -->
          <li>
            <a
              href="https://www.tiktok.com/@dcabra.per"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-white/75 hover:text-white text-sm transition-colors duration-200 group"
            >
              <span class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-white/20 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.86-.74-3.94-1.72-.01 2.2-.01 4.39-.01 6.59-.18 3.71-3.1 6.84-6.81 7.11-3.73.27-7.25-2.22-7.85-5.91-.77-4.71 2.79-9.2 7.53-9.52.28-.02.57-.02.85-.02V10.7c-2.02.05-3.86 1.4-4.22 3.4-.49 2.76 1.42 5.48 4.21 5.86 2.87.39 5.61-1.63 5.92-4.5.04-.37.04-.75.04-1.12V.02z"></path>
                </svg>
              </span>
              @dcabra.pe
            </a>
          </li>
        </ul>
      </div>
    </div>

    <hr class="border-white/15 my-8" />

    <!-- Copyright -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50 font-bold uppercase tracking-wider font-sans">
      <p>
        &copy; {new Date().getFullYear()} D'Cabra. Todos los derechos reservados.
      </p>
      <p>Diseñado con pasión 🐐</p>
    </div>
  </div>
</footer>
