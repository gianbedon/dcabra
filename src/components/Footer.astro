---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

import { Milk, BookOpen, MapPin, Briefcase } from "@lucide/astro";
---

<footer class="bg-primary text-white border-t border-white/10">
  <div class="container mx-auto px-5 py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div class="space-y-5">
        <a href="/">
          <Image src={logo} alt="D'Cabra" class="h-12 w-auto" />
        </a>

        <p class="text-sm text-white/70 leading-relaxed max-w-xs mt-5">
          Productos artesanales elaborados con leche de cabra. Calidad,
          tradición y nutrición para toda la familia.
        </p>
      </div>

      <!-- Productos -->
      <div>
        <p class="font-semibold mb-5">Productos</p>

        <ul class="space-y-3">
          <li>
            <a
              href="/producto"
              class="flex items-center gap-2 text-white/70 hover:text-white transition"
            >
              <Milk size={16} />
              Leche
            </a>
          </li>

          <li>
            <a
              href="/producto"
              class="flex items-center gap-2 text-white/70 hover:text-white transition"
            >
              <Milk size={16} />
              Yogurt Griego
            </a>
          </li>

          <li>
            <a
              href="/producto"
              class="flex items-center gap-2 text-white/70 hover:text-white transition"
            >
              <Milk size={16} />
              Yogurt Frutado
            </a>
          </li>

          <li>
            <a
              href="/producto"
              class="flex items-center gap-2 text-white/70 hover:text-white transition"
            >
              <Milk size={16} />
              Quesos
            </a>
          </li>
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <p class="font-semibold mb-5">Empresa</p>

        <ul class="space-y-3">
          <li>
            <a
              href="/historia"
              class="flex items-center gap-2 text-white/70 hover:text-white transition"
            >
              <BookOpen size={16} />
              Nuestra Historia
            </a>
          </li>

          <li>
            <a
              href="#"
              class="flex items-center gap-2 text-white/70 hover:text-white transition"
            >
              <MapPin size={16} />
              Puntos de Venta
            </a>
          </li>

          <li>
            <a
              href="#"
              class="flex items-center gap-2 text-white/70 hover:text-white transition"
            >
              <Briefcase size={16} />
              Trabaja con Nosotros
            </a>
          </li>
        </ul>
      </div>

      <!-- Redes -->
      <div>
        <p class="font-semibold mb-5">Síguenos</p>

        <div class="flex gap-3">
          <a
            href="https://www.instagram.com/dcabraperu/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-primary transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
            >
              <path
                d="M7.75 2C4.574 2 2 4.574 2 7.75v8.5C2 19.426 4.574 22 7.75 22h8.5C19.426 22 22 19.426 22 16.25v-8.5C22 4.574 19.426 2 16.25 2h-8.5zm0 2h8.5A3.75 3.75 0 0120 7.75v8.5A3.75 3.75 0 0116.25 20h-8.5A3.75 3.75 0 014 16.25v-8.5A3.75 3.75 0 017.75 4zm8.75 1a1.25 1.25 0 100 2.5 1.25 1.25 0 000-2.5zM12 7a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6z"
              ></path>
            </svg>
          </a>

          <a
            href="https://www.facebook.com/dcabraperu"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-primary transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
            >
              <path
                d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.5 1.6-1.5H17V4.9c-.4-.1-1.5-.2-2.8-.2-2.8 0-4.7 1.7-4.7 4.8V11H6.5v3h3v8h4z"
              ></path>
            </svg>
          </a>

          <a
            href="https://www.tiktok.com/@dcabra.per"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-primary transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
            >
              <path
                d="M19.59 6.69a4.83 4.83 0 01-3.77-1.92V15.3a5.3 5.3 0 11-5.3-5.3c.2 0 .4.01.59.03v2.61a2.69 2.69 0 10 2.1 2.63V2h2.58a4.83 4.83 0 003.8 4.69v2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Separador -->
    <div class="mt-12 pt-6 border-t border-white/10">
      <div
        class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white/50"
      >
        <p>
          © {new Date().getFullYear()} D'Cabra. Todos los derechos reservados.
        </p>

        <p>Hecho en Perú 🐐</p>
      </div>
    </div>
  </div>
</footer>
