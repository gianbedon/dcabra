---
import banner from "../assets/portada1.jpg";
import logito from "../assets/logo.png";
import { Image } from "astro:assets";
---

<section class="relative w-full h-[500px] md:h-[650px] overflow-hidden rounded-2xl shadow-lg my-6 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative w-full h-full rounded-2xl overflow-hidden group">
        <Image
            src={banner}
            alt="Portada principal"
            class="w-full h-full object-cover transition-transform duration-[2000ms] ease-out group-hover:scale-105"
            loading="eager"
        />
        
    </div>
</section>
