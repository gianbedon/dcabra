---
import banner from "../assets/portada1.jpg";
import logito from "../assets/logo.png";
import { Image } from "astro:assets";
---
<h1>hola mundo</h1>
<section>
    <Image
        src={banner}
        alt="Portada principal"
        class="w-full h-[700px] object-cover mx-auto rounded-md"
       
    />
    
    <Image
