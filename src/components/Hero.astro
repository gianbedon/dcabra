---
import { Image } from "astro:assets";
import banner from "../assets/portada1.jpg";
import calorias from "../assets/calorias.png";
import proteinas from "../assets/proteinas.png";
import calcio from "../assets/calcio.png";
import potasio from "../assets/potasio.png";
import vitamina from "../assets/vitamina.png";
---

<section class="relative w-full h-screen min-h-[600px] max-h-[800px] overflow-hidden">
  <Image
    src={banner}
    alt="D'Cabra Yogurt Griego"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
  />
  <!-- Overlay oscuro -->
  <div class="absolute inset-0 bg-black/30"></div>

  <!-- Iconos nutricionales en la parte inferior -->
  <div class="absolute bottom-0 left-0 right-0 bg-black/40 backdrop-blur-sm py-5">
    <div class="max-w-4xl mx-auto flex justify-center gap-4 px-4 flex-wrap">
      {[
        { img: calorias, label: "Calorías", val: "168" },
        { img: proteinas, label: "Proteínas", val: "34g" },
        { img: calcio, label: "Calcio", val: "327mg" },
        { img: potasio, label: "Potasio", val: "498mg" },
        { img: vitamina, label: "Vitamina A", val: "483 IU" },
      ].map(item => (
        <div class="flex flex-col items-center bg-purple-700 rounded-2xl px-4 py-3 min-w-[90px]">
          <Image src={item.img} alt={item.label} width={40} height={40} class="mb-1" />
          <span class="text-white font-bold text-xs text-center">{item.label}</span>
          <span class="text-purple-200 text-xs">{item.val}</span>
        </div>
      ))}
    </div>
  </div>
</section>