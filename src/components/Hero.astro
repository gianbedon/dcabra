---
import banner from "../assets/portada1.jpg";
import logito from "../assets/logo.png";
import { Image } from "astro:assets";
---

<section
    class="relative w-full h-[400px] md:h-[650px] overflow-hidden shadow-lg w-full mx-auto"
>
    <div class="relative w-full h-full overflow-hidden group">
        <Image
            src={banner}
            alt="Portada principal"
            class="w-full h-full object-cover transition-transform duration-[2000ms] ease-out group-hover:scale-105"
            loading="eager"
        />
    </div>
</section>
