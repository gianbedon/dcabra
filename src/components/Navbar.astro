---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/producto", label: "Productos" },
  { href: "/historia", label: "Nuestra historia" },
  { href: "/recetas", label: "Recetas" },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-2">
      <Image src={logo} alt="D'Cabra Logo" class="h-10 w-auto object-contain" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {links.map(link => (
        <a 
          href={link.href} 
          class="text-sm font-semibold text-gray-700 hover:text-primary transition-colors duration-200 uppercase tracking-wider"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:block">
      <a 
        href="https://wa.me/51900154196" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-primary hover:bg-primary-dark text-white text-xs font-bold transition-all duration-200 shadow-sm uppercase tracking-wider"
      >
        Pedir por WhatsApp
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button 
      id="hamburger-btn" 
      class="md:hidden p-2 text-primary focus:outline-hidden"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div 
    id="mobile-drawer" 
    class="hidden md:hidden bg-white border-t border-gray-100 px-6 py-4 space-y-3 shadow-md"
  >
    {links.map(link => (
      <a 
        href={link.href} 
        class="block text-sm font-semibold text-gray-700 hover:text-primary transition-colors duration-200 uppercase py-2 border-b border-gray-50"
      >
        {link.label}
      </a>
    ))}
    <a 
      href="https://wa.me/51900154196" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="block text-center mt-4 px-6 py-3 rounded-full bg-primary text-white text-sm font-bold uppercase tracking-wider"
    >
      Pedir por WhatsApp
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('hamburger-btn');
  const drawer = document.getElementById('mobile-drawer');
  const icon = document.getElementById('hamburger-icon');

  btn?.addEventListener('click', () => {
    drawer?.classList.toggle('hidden');
    if (drawer?.classList.contains('hidden')) {
      icon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    } else {
      icon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
    }
  });

  // Close drawer on link click
  const drawerLinks = drawer?.querySelectorAll('a');
  drawerLinks?.forEach(link => {
    link.addEventListener('click', () => {
      drawer?.classList.add('hidden');
      icon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    });
  });
</script>