<style>
  .marquee-container {
    display: flex;
    overflow: hidden;
    width: 100%;
  }

  .marquee-content {
    flex-shrink: 0;
    min-width: 100%;
    justify-content: space-around;
    animation: scroll-marquee 25s linear infinite;
  }

  @keyframes scroll-marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }
</style>
